{
  "name": "week6-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:emit": "prisma contract emit",
    "dev": "nodemon --exec tsx src/index.ts",
    "test_v1": "jest --testPathIgnorePatterns=integration",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=integration",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand --noStackTrace",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/bootcamp_test jest --testPathPatterns=integration",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/cli-engine": "^0.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.1",
    "nodemon": "^3.1.14",
    "prisma": "^8.0.0-rc.10",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.1"
  }
}
